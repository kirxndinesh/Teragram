{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Teragram",
  "identifier": "com.teragram.app",
  "plugins": {
    "updater": {
      "endpoints": []
    }
  },
  "app": {
    "windows": [
      {
        "title": "Teragram",
        "width": 1200,
        "height": 800,
        "minWidth": 1000,
        "minHeight": 700,
        "dragDropEnabled": true,
        "devtools": false
      }
    ]
  },
  "bundle": {
    "createUpdaterArtifacts": false,
    "icon": [
      "icons-teragram/32x32.png",
      "icons-teragram/128x128.png",
      "icons-teragram/128x128@2x.png",
      "icons-teragram/icon.icns",
      "icons-teragram/icon.ico"
    ]
  }
}
